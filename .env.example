# Copiá este archivo como .env y completá los valores

DJANGO_SECRET_KEY=cambiar-por-una-clave-larga
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Base de Manpower (SQL Server)
# Dejá SGO_DB_HOST vacío para trabajar con los datos de ejemplo
# Usuario y contraseña vacíos = autenticación de Windows
SGO_DB_HOST=EGARCIA-LATITUD
SGO_DB_NAME=sgo_new
SGO_DB_PORT=
SGO_DB_USER=
SGO_DB_PASSWORD=
SGO_DB_DRIVER=ODBC Driver 17 for SQL Server

# Asistente de IA: mock | claude | openai | azure | gemini
# "mock" responde con datos de ejemplo y no necesita clave.
# Para Claude: IA_PROVEEDOR=claude, IA_API_KEY=sk-ant-... y pip install anthropic
# IA_MODELO vacío usa el modelo por defecto del proveedor.
IA_PROVEEDOR=mock
IA_API_KEY=
IA_MODELO=
# Solo para Azure OpenAI
IA_AZURE_ENDPOINT=

# Para "Preguntale a la base" conviene un usuario de SQL Server con solo lectura
# (rol db_datareader) en lugar de la autenticación de Windows del administrador.
