# Copiá este archivo como .env y completá los valores

DJANGO_SECRET_KEY=cambiar-por-una-clave-larga
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Base de Manpower (SQL Server)
# Dejá SGO_DB_HOST vacío para trabajar con los datos de ejemplo
# Usuario y contraseña vacíos = autenticación de Windows
SGO_DB_HOST=EGARCIA-LATITUD
SGO_DB_NAME=sgo_new
SGO_DB_PORT=
SGO_DB_USER=
SGO_DB_PASSWORD=
SGO_DB_DRIVER=ODBC Driver 17 for SQL Server

# Asistente de IA (se conecta por HTTP, sin instalar nada)
#   anthropic  API de Claude                     IA_MODELO=claude-sonnet-5-5
#   openai     OpenAI                            IA_MODELO=gpt-4.1
#   openai     cualquier API compatible: poner su dirección en IA_URL
#              DeepSeek   IA_URL=https://api.deepseek.com/v1         IA_MODELO=deepseek-chat
#              Mistral    IA_URL=https://api.mistral.ai/v1           IA_MODELO=mistral-large-latest
#              Groq       IA_URL=https://api.groq.com/openai/v1      IA_MODELO=llama-3.3-70b-versatile
#              Ollama     IA_URL=http://localhost:11434/v1           IA_MODELO=llama3.1 (IA_API_KEY cualquier texto)
#   azure      Azure OpenAI: IA_URL=https://<recurso>.openai.azure.com  IA_MODELO=<deployment>
#   gemini     Google Gemini                     IA_MODELO=gemini-2.5-flash
#   mock       sin IA, datos de ejemplo
IA_PROVEEDOR=mock
IA_API_KEY=
IA_MODELO=
IA_URL=

# Para "Preguntale a la base" conviene un usuario de SQL Server con solo lectura
# (rol db_datareader) en lugar de la autenticación de Windows del administrador.
